# Configuração do banco de dados
DATABASE_URL=postgresql://user:password@localhost:5432/diligencia_elite
# Para desenvolvimento local, você pode usar SQLite:
# DATABASE_URL=sqlite:///diligencia.db

# Configuração JWT
JWT_SECRET=sua-chave-secreta-aqui-mude-em-producao-min-32-caracteres

# Usuário administrador padrão
ADMIN_EMAIL=admin@diligencia-elite.com.br
ADMIN_PASSWORD=AdminPassword123!

# Configuração de porta (Render define automaticamente)
PORT=5000

# Configuração de ambiente
FLASK_ENV=development
# FLASK_ENV=production

# Diretório de dados (usado em desenvolvimento local)
APP_DATA_DIR=./data
# Em produção no Render:
# RENDER_DISK_ROOT=/var/data
